{
  "name": "tripcircle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src scripts eslint.config.js",
    "format:check": "prettier --check src scripts *.json *.ts *.js tests/browser",
    "test:smoke": "playwright test",
    "check": "npm run lint && npm run format:check && npm run build && npm run check:bundle && npm run test:smoke",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2"
  }
}
